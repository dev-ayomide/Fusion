# Required: backend API target for the Vite dev proxy (/api, /previews, /exports, /uploads).
# The dev server refuses to start without this — see vite.config.ts.
VITE_API_PROXY_TARGET=http://localhost:3001

# Set to "true" to require a one-time Interswitch payment before using the app.
# Leave "false" (or unset) for local development.
VITE_ENABLE_PAYWALL=false
